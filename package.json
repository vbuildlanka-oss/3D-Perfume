{
  "name": "kestrel-model-01",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Kestrel Model 01 \u2014 a 3D scrollytelling product site for a fictional running shoe. React, React Three Fiber, GSAP ScrollTrigger and Lenis.",
  "author": "vbuildlanka@gmail.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "verify:story": "bash scripts/verify-story.sh desktop && bash scripts/verify-story.sh mobile",
    "verify:motion": "bash scripts/verify-motion.sh",
    "verify:shop": "bash scripts/verify-interactions.sh"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "gsap": "3.13.0",
    "lenis": "1.3.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "prettier": "3.6.2"
  }
}
